# ============================================
# NFT Public Mint — optional configuration
# ============================================
# Everything here is OPTIONAL. The wizard asks for what it needs and these
# values just become the pre-filled defaults.
#
# Copy to .env:   cp .env.example .env
#
# NEVER put private keys in this file. Keys are pasted into the CLI at run
# time, held in memory only, and never written to disk.

# --- RPC endpoints (recommended) ---
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=

# --- Default chain highlighted in the menu ---
# ethereum | base | robinhood
CHAIN=base

# --- Gas defaults (gwei) ---
# Leave blank to use chain-aware defaults:
# Ethereum 80 / 5, Base 2 / 0.05, Robinhood 0.1 / 0.05.
MAX_FEE_PER_GAS=
MAX_PRIORITY_FEE=

# Gas limit per mint tx.
GAS_LIMIT=250000

# SAFE final preflight lead before scheduled T-0 broadcast.
# Re-checks drop config, quota, supply, balances, base fee and fresh pending nonce,
# then signs close to T-0 instead of hours early.
PREPARE_LEAD_MS=30000

# Dry-run public wallet list. One 0x address per line.
# The wizard auto-loads this file when it exists and saves manual entries here.
PUBLIC_WALLETS_FILE=wallets.txt

# --- OpenSea REST API key (optional) ---
# Used only for slug -> contract lookup. Direct 0x contract input needs no key.
OPENSEA_API_KEY=
