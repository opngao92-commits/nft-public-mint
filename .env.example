# ============================================
# NFT Public Mint — optional configuration
# ============================================
# Everything here is OPTIONAL. The wizard asks for what it needs and these
# values just become the pre-filled defaults.
#
# Copy to .env:   cp .env.example .env
#
# NEVER put private keys in this file.
# For reusable real-mint wallets on Windows, use `npm run vault-setup`.
# Vault files are protected with Windows DPAPI CurrentUser.

# --- RPC endpoints (recommended) ---
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=

# --- Default chain highlighted in the menu ---
# ethereum | base | robinhood
CHAIN=base

# --- Gas defaults (gwei) ---
# Leave blank to use chain-aware defaults:
# Ethereum 80 / 5, Base 2 / 0.05, Robinhood 0.1 / 0.05.
MAX_FEE_PER_GAS=
MAX_PRIORITY_FEE=

# Gas limit per mint tx.
GAS_LIMIT=250000

# Heavy safety-preflight lead. 0 = SAFE chooses dynamically from wallet count.
# For large wallet sets the dynamic lead is intentionally much earlier than T-0.
PREPARE_LEAD_MS=0

# Pending-nonce/signing lead. 0 = SAFE chooses dynamically from wallet count.
SIGN_LEAD_MS=0

# Mode 1 (Wait for on-chain stage) is a LIVE public watcher.
# It polls one lightweight getPublicDrop() call and can adopt an EARLIER startTime
# only when startTime is the sole mint-plan change. Default: 1000 ms.
PUBLIC_WATCH_POLL_MS=1000

# Critical pending-nonce reads use small fast batches instead of blasting every
# wallet at once. Defaults below balance speed with public-RPC rate limits.
NONCE_RPC_CONCURRENCY=5
NONCE_RPC_RETRIES=5
NONCE_RPC_BACKOFF_MS=150

# General wallet RPC guard used by balance / safety reads.
WALLET_RPC_CONCURRENCY=2
WALLET_RPC_RETRIES=6
WALLET_RPC_BACKOFF_MS=350

# Dry-run public wallet list. One 0x address per line.
# The wizard auto-loads this file when it exists and saves manual entries here.
PUBLIC_WALLETS_FILE=wallets.txt

# Windows DPAPI encrypted real-mint wallet vault.
# Multi-vault SAFE can also select named vaults under vaults\*.secure.
WALLET_VAULT_FILE=wallets.secure

# --- OpenSea REST API key (optional) ---
# Used only for slug -> contract lookup. Direct 0x contract input needs no key.
OPENSEA_API_KEY=
